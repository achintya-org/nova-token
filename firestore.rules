rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{walletId} {
      // get (single doc, by known id) is needed by the client to read its own
      // coin balance; list is blocked so the collection can't be scraped/dumped.
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.address is string
                    && request.resource.data.keys().hasOnly(['address', 'firstSeenAt', 'lastSeenAt', 'connections', 'coins', 'lastCoinClaimAt']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'connections', 'coins', 'lastCoinClaimAt']);
      allow delete: if false;
    }

    match /processedTx/{txHash} {
      // Dedupe guard for verified presale purchases: get lets the client check
      // whether a tx hash was already credited; list stays closed so the whole
      // transaction history can't be scraped. Once written, a record is immutable.
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['address', 'novaCredited', 'ts'])
                    && request.resource.data.novaCredited is number
                    && request.resource.data.novaCredited >= 0;
      allow update, delete: if false;
    }
  }
}
