{
  "rules": {
    "board": {
      ".read": true,
      "$linkId": {
        ".write": true,
        "url": {
          ".validate": "newData.isString() && newData.val().length < 2048 && newData.val().matches(/^https?:\\/\\/.+/)"
        },
        "bid": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "preview": {
          "title": { ".validate": "newData.isString() && newData.val().length < 500" },
          "description": { ".validate": "newData.isString() && newData.val().length < 1000" },
          "image": { ".validate": "newData.isString() && newData.val().length < 2048" }
        },
        "$other": { ".validate": false }
      }
    },

    "presale": {
      ".read": true,
      ".write": false,
      "txns": {
        ".write": true,
        "$txnId": {
          ".validate": "newData.hasChildren(['address', 'ethAmount', 'novaAmount', 'time'])",
          "address": { ".validate": "newData.isString() && newData.val().length < 200" },
          "ethAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "novaAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "time": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "raised": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    }
  }
}
